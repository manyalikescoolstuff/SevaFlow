{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer": {
      "root": "customer/frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/qr", "destination": "/qr/index.html" },
        { "source": "/qr/", "destination": "/qr/index.html" }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "rewrites": [{ "source": "/(admin|staff)(/.*)?", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://sevaflow-production.up.railway.app/api/$1" },
    { "source": "/qr", "destination": { "service": "customer" } },
    { "source": "/qr/(.*)", "destination": { "service": "customer" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
